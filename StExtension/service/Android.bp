package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app {
    name: "StNfcExtensionService",
    certificate: "platform",
    privileged: true,
    privapp_allowlist: ":privapp_allowlist_StNfcExtensionService.xml",
    srcs: [
        "**/*.java",
    ],
    resource_dirs: ["res"],
    static_libs: [
        "com.st.android.nfc_extensions-interface",
        // for notifications
        //"androidx.appcompat_appcompat",
    ],
    aaptflags: ["--auto-add-overlay"],
    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

    /* Following is to access hidden interfaces of the NFC framework */
    sdk_version: "core_platform",
    libs: [
        // order matters: classes in framework-nfc are resolved before framework, meaning
        // @hide APIs in framework-nfc are resolved before @SystemApi stubs in framework
        "framework-nfc.impl",
        "framework",

        // if sdk_version="" this gets automatically included, but here we need to add manually.
        "framework-res",
    ],
}

filegroup {
    name: "privapp_allowlist_StNfcExtensionService.xml",
    srcs: ["StNfcExtensionService.xml"],
}
